# SQLite ファイルパス
# ローカル開発: backend/dev.sqlite3 (未指定なら自動)
# Railway 本番: /data/inventory.sqlite3
DATABASE_PATH="./backend/dev.sqlite3"

# ログインに使う唯一のパスワード
APP_PASSWORD="change-me"

# Django SECRET_KEY 兼セッション署名鍵（32文字以上のランダム文字列）
# 例: openssl rand -base64 48
SESSION_SECRET="change-me-please-change-me-please-change-me-please"

# 本番(HTTPS)では 1 に設定
SESSION_COOKIE_SECURE="0"

# Railway 公開URLをカンマ区切りで（POSTのCSRFチェック用）
# 例: https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=""
